<Window x:Class="WinniesMessageBox.PopupWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Popup Window"
        Width="350"
        SizeToContent="Height"
        MinHeight="150"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}">

    <Grid >
        <!-- Top bar with close button -->
        <Grid x:Name="gBody">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="1" Background="#E5FFFFFF" CornerRadius="20" Grid.RowSpan="2" BorderBrush="#FF707070"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,40,10,10">
                <StackPanel x:Name="ProcessStackPanel" Margin="10" Width="350">
                    <!-- Placeholder for dynamic process steps -->
                </StackPanel>
                <Button x:Name="btnOK" Click="Close_Click" Content="Ok" Margin="0"></Button>
            </StackPanel>
        </Grid>
        <Grid Cursor="Hand" x:Name="gBar" Height="40" VerticalAlignment="Top" Margin="0,0,0,1" >
            <Border Background="#19000000" CornerRadius="20,20,0,0"/>
            <Button x:Name="Close" Content="X" Style="{StaticResource MyCloseButton}" Background="#FFE74646" Foreground="White" Click="Close_Click" HorizontalAlignment="Right" Width="58"/>

        </Grid>
    </Grid>

</Window>

